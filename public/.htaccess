<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permanent site migration:
  #   mf.owncircles.com -> modernfisheriese.com
  # These rules are deliberately limited to verified equivalent pages. Apache
  # preserves the original query string because no rule replaces it.

  # Retired legacy downloads have no equivalent on the new site.
  RewriteRule ^assets/docs(?:/|$) - [G,NC,L]
  RewriteRule ^(?:aquaponicsebook|hydroponicsebook|bioflocebooks|catfish|hydroponics_feasibility)\.pdf$ - [G,NC,L]
  RewriteRule ^(?:ebooks?|downloads?)(?:\.html)?/?$ - [G,NC,L]
  RewriteRule ^410/?$ - [G,L]
  RewriteRule ^404/?$ - [R=404,L]

  # Home page (including previously published aliases).
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:index\.html|home(?:\.html)?)?/?$ https://modernfisheriese.com/ [R=301,L,NE]

  # Verified pages whose canonical path is unchanged on the new site.
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(aquaponics-farming|bioflock|hydroponic|pond-farming|fish-diseases|feeding-management|calculators|about-us|privacy-policy)(?:\.html)?/?$ https://modernfisheriese.com/$1 [R=301,L,NE]

  # Verified legacy names whose canonical path changed on the new site.
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:aquaponic|ras|ras-farming|recirculating)(?:\.html)?/?$ https://modernfisheriese.com/ras-farming [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:aquaponics|aquaponic-farming)(?:\.html)?/?$ https://modernfisheriese.com/aquaponics-farming [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:biofloc|biofloc-farming)(?:\.html)?/?$ https://modernfisheriese.com/bioflock [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:hydroponics|hydroponics-farming|soilless)(?:\.html)?/?$ https://modernfisheriese.com/hydroponic [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^pond(?:\.html)?/?$ https://modernfisheriese.com/pond-farming [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^diseases(?:\.html)?/?$ https://modernfisheriese.com/fish-diseases [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^feed(?:\.html)?/?$ https://modernfisheriese.com/feeding-management [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:calculator|calc)(?:\.html)?/?$ https://modernfisheriese.com/calculators [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:ourservices|services|shopping|shop)(?:\.html)?/?$ https://modernfisheriese.com/services [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^about(?:\.html)?/?$ https://modernfisheriese.com/about-us [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:farming-videos|videos)(?:\.html)?/?$ https://modernfisheriese.com/videos [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^(?:frequently-asked-questions|faq)(?:\.html)?/?$ https://modernfisheriese.com/faq [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^privacy(?:\.html)?/?$ https://modernfisheriese.com/privacy-policy [R=301,L,NE]

  # Previously generated short video aliases map to their full new canonicals.
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-1(?:\.html)?/?$ https://modernfisheriese.com/video/fish-harvesting-90-profit-margin-1kg-to-225kg-own-1 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-2(?:\.html)?/?$ https://modernfisheriese.com/video/harvesting-rohu-carp-tilapia-from-pond-own-2 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-3(?:\.html)?/?$ https://modernfisheriese.com/video/biofloc-water-preparation-inoculation-masterclass-own-3 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-4(?:\.html)?/?$ https://modernfisheriese.com/video/small-fish-farming-start-smart-earn-more-own-4 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-5(?:\.html)?/?$ https://modernfisheriese.com/video/watermelon-balcony-garden-setup-hydroponics-own-5 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-6(?:\.html)?/?$ https://modernfisheriese.com/video/protein-skimmer-in-ras-essential-for-clean-water-own-6 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-7(?:\.html)?/?$ https://modernfisheriese.com/video/aquaponics-bed-construction-plant-nitrogen-cycle-own-7 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-8(?:\.html)?/?$ https://modernfisheriese.com/video/harvesting-from-abandoned-tarpaulin-tank-own-8 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-9(?:\.html)?/?$ https://modernfisheriese.com/video/high-density-catfish-feeding-growth-management-own-9 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-10(?:\.html)?/?$ https://modernfisheriese.com/video/releasing-catfish-into-the-pond-part-2-own-10 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-11(?:\.html)?/?$ https://modernfisheriese.com/video/diseases-prevention-water-parameter-testing-own-11 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-12(?:\.html)?/?$ https://modernfisheriese.com/video/water-overflow-solutions-for-houseras-tanks-own-12 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-13(?:\.html)?/?$ https://modernfisheriese.com/video/buying-catfish-for-rs-900-to-stock-in-pond-own-13 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-14(?:\.html)?/?$ https://modernfisheriese.com/video/biofloc-tarpaulin-tank-repair-and-reinforcement-own-14 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-15(?:\.html)?/?$ https://modernfisheriese.com/video/high-density-tilapia-seed-hatchery-fry-management-own-15 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-16(?:\.html)?/?$ https://modernfisheriese.com/video/pond-aeration-venturi-nozzle-setup-guide-own-16 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-17(?:\.html)?/?$ https://modernfisheriese.com/video/automatic-fish-feeder-installation-timer-settings-own-17 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-18(?:\.html)?/?$ https://modernfisheriese.com/video/pond-water-treatment-with-lime-potassium-permanganate-own-18 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-19(?:\.html)?/?$ https://modernfisheriese.com/video/installing-roots-blower-aeration-grid-for-biofloc-own-19 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/own-20(?:\.html)?/?$ https://modernfisheriese.com/video/aquaponics-nft-channel-construction-with-pvc-pipes-own-20 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/idea-1(?:\.html)?/?$ https://modernfisheriese.com/video/high-tech-commercial-ras-recirculating-system-tour-setup-idea-1 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/idea-2(?:\.html)?/?$ https://modernfisheriese.com/video/high-density-biofloc-tilapia-farming-cn-ratio-masterclass-idea-2 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/idea-3(?:\.html)?/?$ https://modernfisheriese.com/video/commercial-aquaponics-vertical-hydroponics-integration-idea-3 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/idea-4(?:\.html)?/?$ https://modernfisheriese.com/video/solar-powered-automated-smart-fish-feeder-iot-sensors-idea-4 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/idea-5(?:\.html)?/?$ https://modernfisheriese.com/video/diy-automatic-drum-filter-construction-for-indoor-fish-tanks-idea-5 [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^video/idea-6(?:\.html)?/?$ https://modernfisheriese.com/video/high-oxygen-dissolution-with-venturi-pure-oxygen-injection-idea-6 [R=301,L,NE]

  # Redirect only generated canonical video-detail pages. The file check
  # prevents unknown /video/* URLs from becoming soft 404s on the new domain.
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/video/$1/index.html -f
  RewriteRule ^video/(.+)\.html$ https://modernfisheriese.com/video/$1 [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/video/$1/index.html -f
  RewriteRule ^video/(.+?)/?$ https://modernfisheriese.com/video/$1 [R=301,L,NE]

  # The new site has a direct equivalent for the old sitemap.
  RewriteCond %{HTTP_HOST} ^mf\.owncircles\.com(?::\d+)?$ [NC]
  RewriteRule ^sitemap\.xml$ https://modernfisheriese.com/sitemap.xml [R=301,L,NE]

  # Unknown paths intentionally fall through to a genuine 404. No SPA fallback
  # is used, so duplicate HTML is not served for migrated page routes.
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
