<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permanently removed documents.
  RewriteRule ^assets/(docs|Docs)/ - [G,NC,L]
  RewriteRule \.pdf$ - [G,NC,L]

  # Legacy aliases to canonical trailing-slash multi-page URLs.
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^(aquaponic|ras-farming|recirculating)/?$ /ras/ [R=301,NC,L]
  RewriteRule ^(aquaponics-farming|aquaponic-farming)/?$ /aquaponics/ [R=301,NC,L]
  RewriteRule ^(bioflock|biofloc-farming)/?$ /biofloc/ [R=301,NC,L]
  RewriteRule ^(hydroponic|hydroponics-farming|soilless)/?$ /hydroponics/ [R=301,NC,L]
  RewriteRule ^pond/?$ /pond-farming/ [R=301,NC,L]
  RewriteRule ^diseases/?$ /fish-diseases/ [R=301,NC,L]
  RewriteRule ^feed/?$ /feeding-management/ [R=301,NC,L]
  RewriteRule ^(calculator|calc)/?$ /calculators/ [R=301,NC,L]
  RewriteRule ^(services|shopping|shop)/?$ /ourservices/ [R=301,NC,L]
  RewriteRule ^about/?$ /about-us/ [R=301,NC,L]
  RewriteRule ^videos/?$ /farming-videos/ [R=301,NC,L]
  RewriteRule ^faq/?$ /frequently-asked-questions/ [R=301,NC,L]
  RewriteRule ^privacy/?$ /privacy-policy/ [R=301,NC,L]

  # Canonical pages use trailing slashes. Match only slashless requests so
  # these rules cannot redirect their own destinations.
  RewriteRule ^(ras|biofloc|aquaponics|hydroponics|pond-farming|fish-diseases|feeding-management|calculators|ourservices|farming-videos|frequently-asked-questions|about-us|privacy-policy)$ /$1/ [R=301,NC,L,NE]

  # Consolidate the duplicate .html URLs generated by the previous build.
  RewriteCond %{REQUEST_URI} !^/(404|410)\.html$ [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

  # Serve each clean URL from its own static directory document.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Existing assets and root index pass through unchanged. Unknown URLs remain 404.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
