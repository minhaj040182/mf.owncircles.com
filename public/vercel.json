{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/assets/Docs/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/assets/docs/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/:path*.pdf",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/pond",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/pond/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/home",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/home/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/videos",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/videos/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/biofloc",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/biofloc/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/hydroponics",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/hydroponics/:path*",
      "destination": "/410.html",
      "statusCode": 410
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/Docs/|assets/docs/|.*\\.pdf|pond|home|videos|biofloc|hydroponics).*)",
      "destination": "/index.html"
    }
  ]
}
