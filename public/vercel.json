{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/assets/Docs/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/assets/docs/:path*",
      "destination": "/410.html",
      "statusCode": 410
    },
    {
      "source": "/:path*.pdf",
      "destination": "/410.html",
      "statusCode": 410
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/Docs/|assets/docs/|.*\\.pdf).*)",
      "destination": "/index.html"
    }
  ]
}
