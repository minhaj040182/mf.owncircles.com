<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permanently removed documents.
  RewriteRule ^assets/(docs|Docs)/ - [G,NC,L]
  RewriteRule \.pdf$ - [G,NC,L]

  # Legacy aliases to canonical multi-page URLs.
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^(aquaponic|ras|recirculating)/?$ /ras-farming [R=301,NC,L]
  RewriteRule ^(aquaponics|aquaponic-farming)/?$ /aquaponics-farming [R=301,NC,L]
  RewriteRule ^(biofloc|biofloc-farming)/?$ /bioflock [R=301,NC,L]
  RewriteRule ^(hydroponics|hydroponics-farming|soilless)/?$ /hydroponic [R=301,NC,L]
  RewriteRule ^pond/?$ /pond-farming [R=301,NC,L]
  RewriteRule ^diseases/?$ /fish-diseases [R=301,NC,L]
  RewriteRule ^feed/?$ /feeding-management [R=301,NC,L]
  RewriteRule ^(calculator|calc)/?$ /calculators [R=301,NC,L]
  RewriteRule ^(ourservices|shopping|shop)/?$ /services [R=301,NC,L]
  RewriteRule ^about/?$ /about-us [R=301,NC,L]
  RewriteRule ^farming-videos/?$ /videos [R=301,NC,L]
  RewriteRule ^frequently-asked-questions/?$ /faq [R=301,NC,L]
  RewriteRule ^privacy/?$ /privacy-policy [R=301,NC,L]

  # Consolidate the duplicate .html URLs generated by the previous build.
  RewriteCond %{REQUEST_URI} !^/(404|410)\.html$ [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

  # Serve each clean URL from its own static directory document.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Existing assets and root index pass through unchanged. Unknown URLs remain 404.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
