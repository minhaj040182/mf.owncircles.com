<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Return HTTP 410 Gone for permanently removed PDF documents & assets/Docs
  RewriteRule ^assets/(docs|Docs)/ - [G,NC,L]
  RewriteRule \.(pdf)$ - [G,NC,L]

  # 2. Permanent 301 Redirects for legacy and alias paths
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^ras/?$ /aquaponic [R=301,L]
  RewriteRule ^ras-farming/?$ /aquaponic [R=301,L]
  RewriteRule ^shopping/?$ /ourservices [R=301,L]
  RewriteRule ^shop/?$ /ourservices [R=301,L]
  RewriteRule ^aquaponics/?$ /aquaponics-farming [R=301,L]
  RewriteRule ^biofloc/?$ /bioflock [R=301,L]
  RewriteRule ^biofloc-farming/?$ /bioflock [R=301,L]
  RewriteRule ^hydroponics/?$ /hydroponic [R=301,L]
  RewriteRule ^pond/?$ /pond-farming [R=301,L]
  RewriteRule ^diseases/?$ /fish-diseases [R=301,L]
  RewriteRule ^feed/?$ /feeding-management [R=301,L]
  RewriteRule ^calculator/?$ /calculators [R=301,L]
  RewriteRule ^calc/?$ /calculators [R=301,L]
  RewriteRule ^services/?$ /ourservices [R=301,L]
  RewriteRule ^about/?$ /about-us [R=301,L]
  RewriteRule ^videos/?$ /farming-videos [R=301,L]
  RewriteRule ^faq/?$ /frequently-asked-questions [R=301,L]
  RewriteRule ^privacy/?$ /privacy-policy [R=301,L]

  # 3. Do not rewrite existing files, directories, or index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule ^ index.html [L]
</IfModule>

# Custom error documents
ErrorDocument 410 /410.html
ErrorDocument 404 /404.html

